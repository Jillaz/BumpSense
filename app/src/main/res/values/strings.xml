    <!-- Диалог "О программе" -->
    <string name="about_title">О программе</string>
    <string name="about_description">🗺️ Запись и анализ маршрутов — отслеживание GPS-координат и фоновый сбор данных с датчиков во время поездки.
📳 Оценка качества дорог — автоматическое определение неровностей и выбоин с помощью акселерометра.
🎨 Цветовая карта неровностей — наглядное выделение участков дороги 5 цветами в зависимости от силы тряски.
📊 Панель телеметрии — мониторинг перегрузок, индекса неровности и пиковых значений в реальном времени.
 Экспорт в GeoJSON — сохранение и обмен записанными маршрутами в универсальном геоформате.
🛰️ История поездок — автоматическое сохранение всех маршрутов с возможностью просмотра на карте.</string>

    <!-- Экран настроек -->
    <string name="settings_title">Настройки</string>
    <string name="settings_back">Назад</string>

    <!-- Настройка: Темная тема -->
    <string name="settings_dark_theme_title">Темная тема</string>
    <string name="settings_dark_theme_on">Включена</string>
    <string name="settings_dark_theme_off">Выключена</string>
    <string name="settings_dark_theme_description">Переключает интерфейс приложения между светлой и темной темой оформления. Темная тема снижает нагрузку на глаза в условиях низкой освещенности и экономит заряд на AMOLED-экранах.</string>

    <!-- Настройка: Частота GPS -->
    <string name="settings_gps_title">Частота GPS</string>
    <string name="settings_gps_description">Как часто обновляются GPS-координаты во время записи маршрута. Меньший интервал дает более точный трек, но увеличивает расход батареи и объем данных. Рекомендуется 2–5 секунд для оптимального баланса точности и энергопотребления.</string>
    <string name="settings_gps_current">Текущий интервал: %d сек</string>
    <string name="settings_gps_unit">сек</string>

    <!-- Настройка: Радиус обновления точек -->
    <string name="settings_radius_title">Радиус обновления точек</string>
    <string name="settings_radius_description">Минимальное расстояние между точками трека. Если новое положение отличается от предыдущего менее чем на указанное значение — точка не записывается. Уменьшение радиуса делает трек более детальным, но увеличивает размер базы. Рекомендуется 10–20 м для городской среды.</string>
    <string name="settings_radius_current">Текущий радиус: %d м</string>
    <string name="settings_radius_unit">м</string>

    <!-- Настройка: Чувствительность акселерометра -->
    <string name="settings_accel_title">Чувствительность акселерометра</string>
    <string name="settings_accel_description">Порог срабатывания детектора неровностей. При меньшем значении фиксируются даже мелкие неровности (трещины, стыки плитки), при большем — только существенные выбоины. Рекомендуется 5–10 м/с² для стандартных дорог.</string>
    <string name="settings_accel_current">Текущий порог: %.1f м/с²</string>
    <string name="settings_accel_unit">м/с²</string>

    <!-- ✅ Настройка: Автосохранение треков -->
    <string name="settings_autosave_title">Автосохранение треков</string>
    <string name="settings_autosave_description">Автоматически разделяет непрерывную запись на отдельные треки заданной длительности. Каждый трек сохраняется в базу отдельно. Рекомендуется 15–30 минут для длительных поездок.</string>
    <string name="settings_autosave_current">Текущий интервал: %d мин</string>

