<?xml version="1.0" encoding="utf-8"?>
<!--
Data Extraction Rules для API 31+ (Android 12+).
Управляет cloud-backup и device-transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- ✅ ИСПРАВЛЕНИЕ: Исключаем БД из облачного backup -->
        <!-- GPS-треки — персональные данные, не должны попадать в облако -->
        <exclude domain="database" path="bumpsense_database" />
        <exclude domain="sharedpref" path="bumpsense_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- ✅ ИСПРАВЛЕНИЕ: Исключаем БД из переноса между устройствами -->
        <!-- Пользователь может экспортировать треки вручную через меню приложения -->
        <exclude domain="database" path="bumpsense_database" />
        <exclude domain="sharedpref" path="bumpsense_prefs.xml" />
    </device-transfer>
</data-extraction-rules>