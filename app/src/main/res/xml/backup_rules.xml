<?xml version="1.0" encoding="utf-8"?>
<!--
Backup rules для Auto Backup (API < 31).
Для API 31+ используется data_extraction_rules.xml.
-->
<full-backup-content>
    <!-- ✅ ИСПРАВЛЕНИЕ: Исключаем БД из backup для защиты приватности -->
    <!-- GPS-треки содержат персональные данные пользователя -->
    <!-- При смене устройства пользователь может экспортировать треки вручную через меню -->
    <exclude domain="database" path="bumpsense_database" />

    <!-- Исключаем SharedPreferences с настройками (не критично, но желательно) -->
    <exclude domain="sharedpref" path="bumpsense_prefs.xml" />
</full-backup-content>